{
  "manifest_version": 3,
  "name": "TNT · 网页爆破",
  "version": "1.0.7",
  "description": "拖动像素 TNT，炸开附近网页画面，短暂停留后快速复原。所有效果在本机完成。",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TNT · 网页爆破",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/tnt.svg",
        "assets/audio/ignite.wav",
        "assets/audio/fuse.wav",
        "assets/audio/blast.wav",
        "assets/audio/restore.wav"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
